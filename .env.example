# ====================================================================
# การตั้งค่า Environment Variables ระบบรับสมัครเรียนออนไลน์ (โควตา 2570)
# วิทยาลัยเทคนิคท่าหลวงซิเมนต์ไทยอนุสรณ์
# ====================================================================

# 1. ข้อมูลวิทยาลัยและระบบ
NEXT_PUBLIC_COLLEGE_NAME="วิทยาลัยเทคนิคท่าหลวงซิเมนต์ไทยอนุสรณ์"
NEXT_PUBLIC_ACADEMIC_YEAR="2570"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 2. Supabase Configuration (เชื่อมต่อ PostgreSQL, Auth, Storage)
# ใส่ค่าจริงจาก Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. รหัสผ่านเจ้าหน้าที่เริ่มต้น (ตามที่กำหนดในภารกิจ)
# เจ้าหน้าที่สามารถเข้าสู่ระบบด้วยเลขบัตร 11999 รหัสผ่าน 090450
ADMIN_DEFAULT_ID="11999"
ADMIN_DEFAULT_PASSWORD="090450"

# 4. การแจ้งเตือน LINE Messaging API / Official Account (เมื่อมีผู้สมัครใหม่หรือเปลี่ยนสถานะ)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_ADMIN_USER_ID=""

# 5. การตั้งค่าการจำกัดและขนาดไฟล์
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"
